{
    "permissions": {
        "deny": ["Read(.env)", "Read(.env.local)", "Read(.env.*)"]
    },
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "npx prettier --write \"$CLAUDE_FILE_PATH\" 2>/dev/null || true"
                    }
                ]
            }
        ]
    }
}
