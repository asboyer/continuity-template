name: CI

on:
  pull_request:
  push:
    branches: [main, master]

jobs:
  checks:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Python (for pre-commit)
        uses: actions/setup-python@v5
        with:
          python-version: '3.x'

      - name: Run pre-commit hooks
        uses: pre-commit/action@v3.0.1

      - name: Validate template initialization
        run: make init-check

      - name: Configure stack commands
        run: |
          echo "LINT_CMD=${LINT_CMD:-echo \"Set LINT_CMD for this repository stack.\"}" >> "$GITHUB_ENV"
          echo "FORMAT_CHECK_CMD=${FORMAT_CHECK_CMD:-echo \"Set FORMAT_CHECK_CMD for this repository stack.\"}" >> "$GITHUB_ENV"
          echo "TEST_CMD=${TEST_CMD:-echo \"Set TEST_CMD for this repository stack.\"}" >> "$GITHUB_ENV"

      - name: Lint
        run: make lint LINT_CMD="$LINT_CMD"

      - name: Format check
        run: make format-check FORMAT_CHECK_CMD="$FORMAT_CHECK_CMD"

      - name: Test
        run: make test TEST_CMD="$TEST_CMD"
